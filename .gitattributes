# LF everywhere, on every OS: a Windows clone with core.autocrlf=true would otherwise get CRLF
# shell scripts (bash cannot run a CRLF script) and fixtures whose bytes the tests compare.
* text=auto eol=lf

# cmd.exe misparses labels and GOTO in LF batch files
*.cmd text eol=crlf
*.bat text eol=crlf

# binary: never converted or diffed as text
*.png binary
*.jpg binary
